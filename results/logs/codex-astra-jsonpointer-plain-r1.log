{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/zsh -lc 'cat jsonpointer.py; cat pyproject.toml; ls -la'","aggregated_output":"# python-json-pointer - An implementation of the JSON Pointer syntax\n# https://github.com/stefankoegl/python-json-pointer\n#\n# Copyright (c) 2011 Stefan Kögl <stefan@skoegl.net>\n# All rights reserved.\n#\n# Redistribution and use in source and binary forms, with or without\n# modification, are permitted provided that the following conditions\n# are met:\n#\n# 1. Redistributions of source code must retain the above copyright\n# notice, this list of conditions and the following disclaimer.\n# 2. Redistributions in binary form must reproduce the above copyright\n# notice, this list of conditions and the following disclaimer in the\n# documentation and/or other materials provided with the distribution.\n# 3. The name of the author may not be used to endorse or promote products\n# derived from this software without specific prior written permission.\n#\n# THIS SOFTWARE IS PROVIDED BY THE AUTHOR ``AS IS'' AND ANY EXPRESS OR\n# IMPLIED WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE IMPLIED WARRANTIES\n# OF MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE ARE DISCLAIMED.\n# IN NO EVENT SHALL THE AUTHOR BE LIABLE FOR ANY DIRECT, INDIRECT,\n# INCIDENTAL, SPECIAL, EXEMPLARY, OR CONSEQUENTIAL DAMAGES (INCLUDING, BUT\n# NOT LIMITED TO, PROCUREMENT OF SUBSTITUTE GOODS OR SERVICES; LOSS OF USE,\n# DATA, OR PROFITS; OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND ON ANY\n# THEORY OF LIABILITY, WHETHER IN CONTRACT, STRICT LIABILITY, OR TORT\n# (INCLUDING NEGLIGENCE OR OTHERWISE) ARISING IN ANY WAY OUT OF THE USE OF\n# THIS SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.\n#\n\n\"\"\" Identify specific nodes in a JSON document (RFC 6901) \"\"\"\n\n# Will be parsed by setup.py to determine package metadata\n__author__ = 'Stefan Kögl <stefan@skoegl.net>'\n__version__ = '3.2.1'\n__website__ = 'https://github.com/stefankoegl/python-json-pointer'\n__license__ = 'Modified BSD License'\n\nimport copy\nimport re\nfrom collections.abc import Mapping, Sequence\nfrom itertools import tee, chain\n\n_nothing = object()\n\n# If True, exceptions include the doc content in the error message.\n# Set to False to suppress potentially large document content from exceptions.\nVERBOSE_EXCEPTIONS = True\n\n\ndef set_pointer(doc, pointer, value, inplace=True):\n    \"\"\"Resolves a pointer against doc and sets the value of the target within doc.\n\n    With inplace set to true, doc is modified as long as pointer is not the\n    root.\n\n    >>> obj = {'foo': {'anArray': [ {'prop': 44}], 'another prop': {'baz': 'A string' }}}\n\n    >>> set_pointer(obj, '/foo/anArray/0/prop', 55) == \\\n    {'foo': {'another prop': {'baz': 'A string'}, 'anArray': [{'prop': 55}]}}\n    True\n\n    >>> set_pointer(obj, '/foo/yet another prop', 'added prop') == \\\n    {'foo': {'another prop': {'baz': 'A string'}, 'yet another prop': 'added prop', 'anArray': [{'prop': 55}]}}\n    True\n\n    >>> obj = {'foo': {}}\n    >>> set_pointer(obj, '/foo/a%20b', 'x') == \\\n    {'foo': {'a%20b': 'x' }}\n    True\n    \"\"\"\n\n    pointer = JsonPointer(pointer)\n    return pointer.set(doc, value, inplace)\n\n\ndef resolve_pointer(doc, pointer, default=_nothing):\n    \"\"\" Resolves pointer against doc and returns the referenced object\n\n    >>> obj = {'foo': {'anArray': [ {'prop': 44}], 'another prop': {'baz': 'A string' }}, 'a%20b': 1, 'c d': 2}\n\n    >>> resolve_pointer(obj, '') == obj\n    True\n\n    >>> resolve_pointer(obj, '/foo') == obj['foo']\n    True\n\n    >>> resolve_pointer(obj, '/foo/another prop') == obj['foo']['another prop']\n    True\n\n    >>> resolve_pointer(obj, '/foo/another prop/baz') == obj['foo']['another prop']['baz']\n    True\n\n    >>> resolve_pointer(obj, '/foo/anArray/0') == obj['foo']['anArray'][0]\n    True\n\n    >>> resolve_pointer(obj, '/some/path', None) == None\n    True\n\n    >>> resolve_pointer(obj, '/a b', None) == None\n    True\n\n    >>> resolve_pointer(obj, '/a%20b') == 1\n    True\n\n    >>> resolve_pointer(obj, '/c d') == 2\n    True\n\n    >>> resolve_pointer(obj, '/c%20d', None) == None\n    True\n    \"\"\"\n\n    pointer = JsonPointer(pointer)\n    return pointer.resolve(doc, default)\n\n\ndef pairwise(iterable):\n    \"\"\" Transforms a list to a list of tuples of adjacent items\n\n    s -> (s0,s1), (s1,s2), (s2, s3), ...\n\n    >>> list(pairwise([]))\n    []\n\n    >>> list(pairwise([1]))\n    []\n\n    >>> list(pairwise([1, 2, 3, 4]))\n    [(1, 2), (2, 3), (3, 4)]\n    \"\"\"\n    a, b = tee(iterable)\n    for _ in b:\n        break\n    return zip(a, b)\n\n\nclass JsonPointerException(Exception):\n    pass\n\n\nclass EndOfList:\n    \"\"\"Result of accessing element \"-\" of a list\"\"\"\n\n    def __init__(self, list_):\n        self.list_ = list_\n\n    def __repr__(self):\n        return '{cls}({lst})'.format(cls=self.__class__.__name__,\n                                     lst=repr(self.list_))\n\n\nclass JsonPointer:\n    \"\"\"A JSON Pointer that can reference parts of a JSON document\"\"\"\n\n    # Array indices must not contain:\n    # leading zeros, signs, spaces, decimals, etc\n    _RE_ARRAY_INDEX = re.compile('0|[1-9][0-9]*$')\n    _RE_INVALID_ESCAPE = re.compile('(~[^01]|~$)')\n\n    def __init__(self, pointer):\n\n        # validate escapes\n        invalid_escape = self._RE_INVALID_ESCAPE.search(pointer)\n        if invalid_escape:\n            raise JsonPointerException('Found invalid escape {}'.format(\n                invalid_escape.group()))\n\n        parts = pointer.split('/')\n        if parts.pop(0) != '':\n            raise JsonPointerException('Location must start with /')\n\n        parts = [unescape(part) for part in parts]\n        self.parts = parts\n\n    def to_last(self, doc):\n        \"\"\"Resolves ptr until the last step, returns (sub-doc, last-step)\"\"\"\n\n        if not self.parts:\n            return doc, None\n\n        for part in self.parts[:-1]:\n            doc = self.walk(doc, part)\n\n        return doc, JsonPointer.get_part(doc, self.parts[-1])\n\n    def resolve(self, doc, default=_nothing):\n        \"\"\"Resolves the pointer against doc and returns the referenced object\"\"\"\n\n        for part in self.parts:\n\n            try:\n                doc = self.walk(doc, part)\n            except JsonPointerException:\n                if default is _nothing:\n                    raise\n                else:\n                    return default\n\n        return doc\n\n    get = resolve\n\n    def set(self, doc, value, inplace=True):\n        \"\"\"Resolve the pointer against the doc and replace the target with value.\"\"\"\n\n        if len(self.parts) == 0:\n            if inplace:\n                raise JsonPointerException('Cannot set root in place')\n            return value\n\n        if not inplace:\n            doc = copy.deepcopy(doc)\n\n        (parent, part) = self.to_last(doc)\n\n        if isinstance(parent, str):\n            raise JsonPointerException(\"Cannot set value in a string\")\n        elif isinstance(parent, Sequence) and part == '-':\n            parent.append(value)\n        else:\n            try:\n                parent[part] = value\n            except (TypeError, IndexError) as e:\n                raise JsonPointerException(\"Invalid assignment target: %s\" % (e,))\n\n        return doc\n\n    @classmethod\n    def get_part(cls, doc, part):\n        \"\"\"Returns the next step in the correct type\"\"\"\n\n        if isinstance(doc, Mapping):\n            return part\n\n        elif isinstance(doc, str):\n            raise JsonPointerException(\"Cannot apply token '%s' to non-container type %s\" % (part, type(doc)))\n\n        elif isinstance(doc, Sequence):\n\n            if part == '-':\n                return part\n\n            if not JsonPointer._RE_ARRAY_INDEX.fullmatch(str(part)):\n                raise JsonPointerException(\"'%s' is not a valid sequence index\" % part)\n\n            try:\n                return int(part)\n            except ValueError as e:\n                raise JsonPointerException(\"Invalid sequence index: %s\" % (e,))\n\n        elif hasattr(doc, '__getitem__'):\n            # Allow indexing via ducktyping\n            # if the target has defined __getitem__\n            return part\n\n        else:\n            raise JsonPointerException(\"Document '%s' does not support indexing, \"\n                                       \"must be mapping/sequence or support __getitem__\" % type(doc))\n\n    def get_parts(self):\n        \"\"\"Returns the list of the parts. For example, JsonPointer('/a/b').get_parts() == ['a', 'b']\"\"\"\n\n        return self.parts\n\n    def walk(self, doc, part):\n        \"\"\" Walks one step in doc and returns the referenced part \"\"\"\n\n        part = JsonPointer.get_part(doc, part)\n\n        assert hasattr(doc, '__getitem__'), \"invalid document type %s\" % (type(doc),)\n\n        if isinstance(doc, Sequence):\n            if part == '-':\n                return EndOfList(doc)\n\n            try:\n                return doc[part]\n\n            except IndexError:\n                raise JsonPointerException(\"index '%s' is out of bounds\" % (part,))\n\n        # Else the object is a mapping or supports __getitem__(so assume custom indexing)\n        try:\n            return doc[part]\n\n        except KeyError:\n            if VERBOSE_EXCEPTIONS:\n                raise JsonPointerException(\"member '%s' not found in %s\" % (part, doc))\n            else:\n                raise JsonPointerException(\"member '%s' not found\" % (part,))\n\n    def contains(self, ptr):\n        \"\"\" Returns True if self contains the given ptr \"\"\"\n        return self.parts[:len(ptr.parts)] == ptr.parts\n\n    def __contains__(self, item):\n        \"\"\" Returns True if self contains the given ptr \"\"\"\n        return self.contains(item)\n\n    def join(self, suffix):\n        \"\"\" Returns a new JsonPointer with the given suffix append to this ptr \"\"\"\n        if isinstance(suffix, JsonPointer):\n            suffix_parts = suffix.parts\n        elif isinstance(suffix, str):\n            suffix_parts = JsonPointer(suffix).parts\n        else:\n            suffix_parts = suffix\n        try:\n            return self.__class__.from_parts(chain(self.parts, suffix_parts))\n        except:  # noqa E722\n            raise JsonPointerException(\"Invalid suffix\")\n\n    def __truediv__(self, suffix):\n        return self.join(suffix)\n\n    @property\n    def path(self):\n        \"\"\"Returns the string representation of the pointer\n\n        >>> ptr = JsonPointer('/~0/0/~1').path == '/~0/0/~1'\n        \"\"\"\n        parts = [escape(part) for part in self.parts]\n        return ''.join('/' + part for part in parts)\n\n    def __eq__(self, other):\n        \"\"\"Compares a pointer to another object\n\n        Pointers can be compared by comparing their strings (or splitted\n        strings), because no two different parts can point to the same\n        structure in an object (eg no different number representations)\n        \"\"\"\n\n        if not isinstance(other, JsonPointer):\n            return False\n\n        return self.parts == other.parts\n\n    def __hash__(self):\n        return hash(tuple(self.parts))\n\n    def __str__(self):\n        return self.path\n\n    def __repr__(self):\n        return type(self).__name__ + \"(\" + repr(self.path) + \")\"\n\n    @classmethod\n    def from_parts(cls, parts):\n        \"\"\"Constructs a JsonPointer from a list of (unescaped) paths\n\n        >>> JsonPointer.from_parts(['a', '~', '/', 0]).path == '/a/~0/~1/0'\n        True\n        \"\"\"\n        parts = [escape(str(part)) for part in parts]\n        ptr = cls(''.join('/' + part for part in parts))\n        return ptr\n\n\ndef escape(s):\n    return s.replace('~', '~0').replace('/', '~1')\n\n\ndef unescape(s):\n    return s.replace('~1', '/').replace('~0', '~')\n[tool.mutmut]\nsource_paths = [\"jsonpointer.py\"]\npytest_add_cli_args_test_selection = [\"tests/\"]\npytest_add_cli_args = [\"-q\", \"-p\", \"no:cacheprovider\", \"-k\", \"not CommandLineTests\"]\n\n[tool.pytest.ini_options]\npythonpath = [\".\"]\ntotal 32\ndrwxr-xr-x@  6 nazmul  wheel    192 Oct 11 12:00 .\ndrwxr-xr-x@  3 nazmul  wheel     96 Oct 11 12:00 ..\ndrwxr-xr-x@ 12 nazmul  wheel    384 Oct 11 12:00 .git\n-rw-r--r--@  1 nazmul  wheel  11409 Oct 11 12:00 jsonpointer.py\n-rw-r--r--@  1 nazmul  wheel    227 Oct 11 12:00 pyproject.toml\ndrwxr-xr-x@  2 nazmul  wheel     64 Oct 11 12:00 tests\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_3","type":"agent_message","text":"The implementation includes resolution, assignment, escaping, pointer composition, and custom-container support. I’ll test those behaviors, with particular attention to invalid array indices, copy isolation, and escaped path segments."}}
{"type":"item.started","item":{"id":"item_4","type":"command_execution","command":"/bin/zsh -lc \"cat > tests/test_agent.py <<'PY'\n\\\"\\\"\\\"Behavioral tests derived from the local jsonpointer implementation.\\\"\\\"\\\"\n\nfrom collections import UserDict\nfrom copy import deepcopy\n\nimport pytest\n\nimport jsonpointer as jp\nfrom jsonpointer import JsonPointer, JsonPointerException, resolve_pointer, set_pointer\n\n\n@pytest.mark.parametrize('value', [None, False, 0, '', [], {}, {'a': [1]}])\ndef test_root_returns_original(value):\n    assert resolve_pointer(value, '') is value\n    assert JsonPointer('').get(value) is value\n    parent, token = [REDACTED_SECRET]'').to_last(value)\n    assert parent is value\n    assert token is None\n\n\n@pytest.mark.parametrize(('path', 'expected'), [\n    ('/', 'empty'), ('/a~1b', 'slash'), ('/m~0n', 'tilde'),\n    ('/~01', 'literal escape'), ('/a%20b', 'percent'),\n    ('/a b', 'space'), ('/বাংলা', 'unicode'), ('//', 'nested empty'),\n])\ndef test_literal_keys_and_escaping(path, expected):\n    doc = {'': {'': 'nested empty'}, 'a/b': 'slash', 'm~n': 'tilde',\n           '~1': 'literal escape', 'a%20b': 'percent', 'a b': 'space',\n           'বাংলা': 'unicode'}\n    if path == '/':\n        doc[''] = 'empty'\n    assert resolve_pointer(doc, path) == expected\n\n\n@pytest.mark.parametrize('path', ['a', 'a/b', '#/a', ' /a', '/~', '/~2',\n                                  '/a~x', '/a/~10~', '/~~0'])\ndef test_invalid_pointer_syntax(path):\n    with pytest.raises(JsonPointerException):\n        JsonPointer(path)\n    with pytest.raises(JsonPointerException):\n        resolve_pointer({}, path, default=None)\n\n\n@pytest.mark.parametrize(('raw', 'encoded'), [\n    ('', ''), ('a/b', 'a~1b'), ('~', '~0'), ('~1', '~01'),\n    ('~/~0', '~0~1~00'), ('%20 বাংলা', '%20 বাংলা'),\n])\ndef test_escape_helpers(raw, encoded):\n    assert jp.escape(raw) == encoded\n    assert jp.unescape(encoded) == raw\n\n\ndef test_nested_resolution_preserves_identity_and_document():\n    target = {'value': [None, False, 0, '']}\n    doc = {'items': [42, {'a/b': target}]}\n    before = deepcopy(doc)\n    pointer = JsonPointer('/items/1/a~1b')\n    assert pointer.resolve(doc) is target\n    assert pointer.get(doc) is target\n    assert pointer.walk(doc, 'items') is doc['items']\n    assert doc == before\n    assert pointer.to_last(doc) == (doc['items'][1], 'a/b')\n    parent, token = [REDACTED_SECRET]'/items/1').to_last(doc)\n    assert parent is doc['items']\n    assert token == 1\n    assert type(token) is int\n\n\n@pytest.mark.parametrize('token', ['00', '01', '-1', '+1', ' 1', '1 ',\n                                   '1.0', '1e0', '', '0x0', '1\\\\n', '١'])\ndef test_noncanonical_array_indices_rejected(token):\n    with pytest.raises(JsonPointerException):\n        resolve_pointer([10, 20], '/' + token)\n    assert resolve_pointer([10, 20], '/' + token, 'missing') == 'missing'\n    assert resolve_pointer({token: 'literal'}, '/' + token) == 'literal'\n\n\n@pytest.mark.parametrize('doc', [[4, 5], (4, 5)])\ndef test_sequence_indices_and_bounds(doc):\n    assert resolve_pointer(doc, '/0') == 4\n    assert resolve_pointer(doc, '/1') == 5\n    for index in [2, 100]:\n        with pytest.raises(JsonPointerException, match='out of bounds'):\n            resolve_pointer(doc, '/' + str(index))\n\n\n@pytest.mark.parametrize('doc,path', [({}, '/missing'), ({'a': {}}, '/a/b'),\n    ([], '/0'), ({'a': [1]}, '/a/2'), (None, '/x'), (3, '/0'),\n    (True, '/x'), ('abc', '/0'), ({'a': None}, '/a/b')])\ndef test_failures_and_explicit_defaults(doc, path):\n    with pytest.raises(JsonPointerException):\n        resolve_pointer(doc, path)\n    for fallback in [None, False, 0, '', object()]:\n        assert resolve_pointer(doc, path, fallback) is fallback\n        assert JsonPointer(path).get(doc, fallback) is fallback\n\n\n@pytest.mark.parametrize('value', [None, False, 0, '', [], {}])\ndef test_existing_falsy_values_do_not_use_default(value):\n    assert resolve_pointer({'key': value}, '/key', object()) is value\n\n\ndef test_end_of_list_is_a_marker_not_last_item():\n    items = [1, 2]\n    marker = resolve_pointer(items, '-') if False else resolve_pointer(items, '/-')\n    assert isinstance(marker, jp.EndOfList)\n    assert marker.list_ is items\n    assert repr(marker) == 'EndOfList([1, 2])'\n    assert resolve_pointer({'-': 7}, '/-') == 7\n    with pytest.raises(JsonPointerException):\n        resolve_pointer(items, '/-/child')\n\n\n@pytest.mark.parametrize('use_wrapper', [False, True])\ndef test_set_replaces_adds_and_appends_in_place(use_wrapper):\n    doc = {'items': [{'x': 1}], 'other': [9]}\n    def assign(path, value):\n        if use_wrapper:\n            return set_pointer(doc, path, value)\n        return JsonPointer(path).set(doc, value)\n    assert assign('/items/0/x', 2) is doc\n    assert assign('/items/0/a~1b', 3) is doc\n    inserted = {'new': True}\n    assert assign('/items/-', inserted) is doc\n    assert doc == {'items': [{'x': 2, 'a/b': 3}, {'new': True}], 'other': [9]}\n    assert doc['items'][1] is inserted\n    assert assign('/items/0', None) is doc\n    assert doc['items'] == [None, inserted]\n    assert assign('/-', 4) is doc\n    assert doc['-'] == 4\n\n\n@pytest.mark.parametrize('path,value', [('/a/0/x', 8), ('/a/-', {'x': 3}), ('/new', 4)])\ndef test_non_inplace_set_deepcopies_document(path, value):\n    doc = {'a': [{'x': 1}], 'untouched': {'nested': []}}\n    before = deepcopy(doc)\n    result = set_pointer(doc, path, value, inplace=False)\n    assert result is not doc\n    assert doc == before\n    assert result['a'] is not doc['a']\n    assert result['a'][0] is not doc['a'][0]\n    result['untouched']['nested'].append(2)\n    assert doc['untouched']['nested'] == []\n    if path.endswith('-'):\n        assert result['a'][-1] is value\n    else:\n        assert resolve_pointer(result, path) == value\n\n\ndef test_root_assignment():\n    doc = {'old': [1]}\n    value = {'replacement': []}\n    with pytest.raises(JsonPointerException, match='root'):\n        set_pointer(doc, '', value)\n    assert set_pointer(doc, '', value, inplace=False) is value\n    assert doc == {'old': [1]}\n\n\n@pytest.mark.parametrize('doc,path', [({'a': []}, '/a/0'), ({'a': [1]}, '/a/1'),\n    ({}, '/missing/child'), ({'a': 'abc'}, '/a/0'),\n    ({'a': (1, 2)}, '/a/0'), ({'a': 3}, '/a/x'), ({'a': [1]}, '/a/-1')])\ndef test_invalid_assignments_do_not_modify_document(doc, path):\n    before = deepcopy(doc)\n    with pytest.raises(JsonPointerException):\n        set_pointer(doc, path, 9)\n    assert doc == before\n\n\ndef test_parts_and_representations():\n    pointer = JsonPointer.from_parts(iter(['', 'a/b', '~1', 0, 'বাংলা']))\n    assert pointer.parts == ['', 'a/b', '~1', '0', 'বাংলা']\n    assert pointer.get_parts() == pointer.parts\n    assert pointer.path == '//a~1b/~01/0/বাংলা'\n    assert str(pointer) == pointer.path\n    assert repr(pointer) == 'JsonPointer(' + repr(pointer.path) + ')'\n    assert JsonPointer(pointer.path) == pointer\n    assert JsonPointer.from_parts([]).path == ''\n    assert JsonPointer('/a') \"'!= JsonPointer('\"'/b')\n    assert JsonPointer('/a') \"'!= '\"'/a'\n    assert JsonPointer('/a') \"'!= None\n    assert len({JsonPointer('\"'/a'), JsonPointer.from_parts(['a'])}) == 1\n    assert {pointer: 'found'}[JsonPointer(pointer.path)] == 'found'\n\n\n@pytest.mark.parametrize('suffix', ['/b~1c/~0', JsonPointer('/b~1c/~0'), ['b/c', '~']])\ndef test_join_and_division(suffix):\n    base = JsonPointer('/a')\n    assert base.join(suffix).path == '/a/b~1c/~0'\n    assert (base / suffix).parts == ['a', 'b/c', '~']\n    assert base.path == '/a'\n    assert base.join('') == base\n    assert base.join('') is not base\n    assert JsonPointer('').join(base) == base\n\n\n@pytest.mark.parametrize('suffix', [None, 42, '/bad~2', 'missing-slash'])\ndef test_invalid_join(suffix):\n    with pytest.raises(JsonPointerException):\n        JsonPointer('/a').join(suffix)\n\n\ndef test_subclass_construction_and_join():\n    class Pointer(JsonPointer):\n        pass\n    pointer = Pointer.from_parts(['a'])\n    assert isinstance(pointer, Pointer)\n    assert isinstance(pointer.join('/b'), Pointer)\n    assert repr(pointer) == \\\"Pointer('/a')\\\"\n\n\n@pytest.mark.parametrize('path,prefix,expected', [\n    ('/a/b', '/a', True), ('/a', '/a', True), ('/a', '', True),\n    ('', '/a', False), ('/a', '/a/b', False), ('/ab', '/a', False),\n    ('/a~1b', '/a', False), ('/a/b', '/b', False),\n])\ndef test_contains_uses_complete_prefix_tokens(path, prefix, expected):\n    # This API tests whether the argument is a prefix of self.\n    pointer, ancestor = JsonPointer(path), JsonPointer(prefix)\n    assert pointer.contains(ancestor) is expected\n    assert (ancestor in pointer) is expected\n\n\ndef test_mapping_and_duck_typed_containers():\n    assert resolve_pointer(UserDict({'0': ['ok']}), '/0/0') == 'ok'\n    class Container:\n        def __init__(self):\n            self.data = {'key': [7]}\n        def __getitem__(self, key):\n            return self.data[key]\n        def __setitem__(self, key, value):\n            self.data[key] = value\n    doc = Container()\n    assert resolve_pointer(doc, '/key/0') == 7\n    assert set_pointer(doc, '/new', 8) is doc\n    assert doc.data['new'] == 8\n    with pytest.raises(JsonPointerException):\n        resolve_pointer(doc, '/absent')\n\n\n@pytest.mark.parametrize('verbose', [True, False])\ndef test_exception_document_visibility(monkeypatch, verbose):\n    monkeypatch.setattr(jp, 'VERBOSE_EXCEPTIONS', verbose)\n    doc = {'secret': 'sensitive content'}\n    with pytest.raises(JsonPointerException) as error:\n        resolve_pointer(doc, '/missing')\n    message = str(error.value)\n    assert 'missing' in message\n    assert ('sensitive content' in message) is verbose\n\n\n@pytest.mark.parametrize('items,expected', [([], []), ([1], []),\n    ([1, 2], [(1, 2)]), ([1, 2, 3], [(1, 2), (2, 3)])])\ndef test_pairwise_accepts_one_shot_iterators(items, expected):\n    assert list(jp.pairwise(iter(items))) == expected\nPY\n<repo>/.venv/bin/python -m pytest tests\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
